{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "slogan": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "favicon_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#DC2626"
    },
    "accent_color": {
      "type": "string",
      "default": "#F97316"
    },
    "secondary_color": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "facebook": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "is_open": {
      "type": "boolean",
      "default": true
    },
    "opening_hours": {
      "type": "string"
    },
    "minimum_order": {
      "type": "number",
      "default": 0
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "estimated_delivery_time": {
      "type": "number",
      "default": 30
    },
    "delivery_radius": {
      "type": "number",
      "default": 0
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "default": "light"
    },
    "plan": {
      "type": "string",
      "enum": [
        "solo",
        "equipe",
        "multi_unidade"
      ],
      "default": "solo"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "suspended"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}