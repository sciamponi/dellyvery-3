{
  "name": "Plan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ],
      "default": "monthly"
    },
    "limits_users": {
      "type": "number",
      "default": 1
    },
    "limits_orders": {
      "type": "number",
      "default": -1
    },
    "limits_products": {
      "type": "number",
      "default": -1
    },
    "limits_customers": {
      "type": "number",
      "default": -1
    },
    "limits_whatsapp": {
      "type": "number",
      "default": 0
    },
    "limits_ia": {
      "type": "boolean",
      "default": false
    },
    "limits_storage_mb": {
      "type": "number",
      "default": 100
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}