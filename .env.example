# DELLVERY 3 — Supabase (local/remote)
# Copie para .env.local e preencha com valores do dashboard Supabase
# Nunca commitar .env.local ou service_role

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública p/ QR Codes em desenvolvimento (teste com celular na rede local).
# Ex.: VITE_PUBLIC_URL=http://192.168.0.10:5173
# - Sem ela, o QR usa a origem atual (localhost, inacessível ao celular).
# - Nunca aponte para produção aqui; a VPS usa o próprio .env, intocado.
# - Para servir na rede: `npm run dev -- --host 0.0.0.0` (firewall libera 5173).
#   Limitação: o Supabase local (127.0.0.1:54321) NÃO é alcançável pelo celular;
#   o QR abre, mas cardápio/checkout exigem o backend. Teste completo do fluxo
#   com mesa: neste PC, ou com o backend exposto de forma segura (túnel/ homolog).

# Base44 (legado, mantido até migração completa)
# VITE_BASE44_APP_ID=
# VITE_BASE44_APP_BASE_URL=
# VITE_BASE44_FUNCTIONS_VERSION=
