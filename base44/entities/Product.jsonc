{
  "name": "Product",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "promotional_price": {
      "type": "number"
    },
    "sku": {
      "type": "string"
    },
    "internal_code": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "is_made_to_order": {
      "type": "boolean",
      "default": false
    },
    "out_of_stock": {
      "type": "boolean",
      "default": false
    },
    "stock": {
      "type": "number",
      "default": -1
    },
    "preparation_time": {
      "type": "number",
      "default": 15
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_bestseller": {
      "type": "boolean",
      "default": false
    },
    "ingredients": {
      "type": "string"
    },
    "nutritional_info": {
      "type": "string"
    },
    "complements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "max_select": {
            "type": "number",
            "default": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "number",
                  "default": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "company_id",
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}